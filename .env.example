# Gandalf runtime configuration
GANDALF_REQUEST_TIMEOUT=30
GANDALF_CHAT_HISTORY=.runtime/chat_history.txt

# Speech recognition
GANDALF_STT_WEBSITE_URL=https://allorizenproject1.netlify.app/

# Vision
GANDALF_VISION_ENDPOINT=https://api.deepinfra.com/v1/openai/chat/completions
GANDALF_VISION_MODEL=llava-hf/llava-1.5-7b-hf
DEEPINFRA_API_KEY=
GANDALF_MOBILE_CAMERA_URL=

# Text to speech
GANDALF_TTS_ENDPOINT=https://api.streamelements.com/kappa/v2/speech
GANDALF_TTS_VOICE=Matthew

# Image generation
GANDALF_IMAGE_ENDPOINT=https://api.airforce/v1/imagine2

# Optional messaging integration (disabled by default)
GANDALF_WHATSAPP_RECIPIENT=
GANDALF_ALLOW_WHATSAPP_SEND=false
